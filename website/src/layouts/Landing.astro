---
import { copy, type Locale } from '../content/copy';
import { repository } from '../config/release';
import Download from '../components/Download.astro';
import ProductPreview from '../components/ProductPreview.astro';
import '../styles/site.css';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = copy[locale];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const en = `${base}/`;
const ru = `${base}/ru/`;
const absolute = (path: string) => new URL(path, Astro.site).href;
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.title}</title>
    <meta name="description" content={t.description} />
    <meta name="theme-color" content="#0d0e0e" />
    <link rel="canonical" href={absolute(locale === 'en' ? en : ru)} />
    <link rel="alternate" hreflang="en" href={absolute(en)} />
    <link rel="alternate" hreflang="ru" href={absolute(ru)} />
    <link rel="alternate" hreflang="x-default" href={absolute(en)} />
    <link rel="icon" type="image/png" href={`${base}/images/icon.png`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Harbor Player" />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.description} />
    <meta property="og:url" content={absolute(locale === 'en' ? en : ru)} />
    <meta property="og:image" content={absolute(`${base}/images/social.jpg`)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.screenshot} />
    <meta property="og:locale" content={locale === 'en' ? 'en_US' : 'ru_RU'} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>
    <div class="room" aria-hidden="true"></div>
    <header class="site-header shell">
      <a class="brand" href={locale === 'en' ? en : ru}>Harbor Player</a>
    </header>
    <main id="main">
      <section class="hero shell" aria-labelledby="hero-title">
        <div class="hero-copy">
          <h1 id="hero-title">{t.slogan[0]}<br />{t.slogan[1]}</h1>
          <p class="intro">{t.description}</p>
          <Download t={t} />
        </div>
        <ProductPreview t={t} />
      </section>
      <div class="shell"><ul class="features" role="list">{t.features.map(feature => <li>{feature}</li>)}</ul></div>
    </main>
    <footer class="site-footer shell"><a href={`${repository}/blob/main/LICENSE`}>{t.license}</a></footer>
  </body>
</html>
