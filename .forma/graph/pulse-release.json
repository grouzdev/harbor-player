    {
      "id": "pulse.recording",
      "role": "implementation",
      "label": "Учёт подтверждённого времени",
      "summary": {
        "text": "Recorder рядом с audio накапливает реальное время подтверждённого воспроизведения; пауза и seek не добавляют его. Доставка использует IndexedDB outbox и накопительные revisions; checkpoint выполняется примерно раз в 15 секунд.",
        "provenance": {
          "recordedBy": "Codex",
          "recordedAt": "2026-10-20T23:24:58Z",
          "basis": "sourced",
          "evidence": [
            "source.recorder",
            "source.player",
            "source.pulse-reference"
          ],
          "reviewedBy": null,
          "reviewedAt": null
        }
      },
      "scope": null,
      "content": "source.pulse-reference",
      "author": null,
      "acceptance": "not-applicable",
      "provenance": {
        "recordedBy": "Codex",
        "recordedAt": "2026-10-20T23:24:58Z",
        "basis": "sourced",
        "evidence": [
          "source.recorder",
          "source.player",
          "source.pulse-reference"
        ],
        "reviewedBy": null,
        "reviewedAt": null
      },
      "run": null
    },
    {
      "id": "pulse.storage",
      "role": "implementation",
      "label": "История и очистка в SQLite",
      "summary": {
        "text": "API сохраняет интервалы и агрегаты в SQLite. Смена поколения при очистке отвергает старые ожидающие события. Часовой пояс фиксируется; изменение уже выбранной зоны явно отклоняется.",
        "provenance": {
          "recordedBy": "Codex",
          "recordedAt": "2026-10-20T23:24:58Z",
          "basis": "sourced",
          "evidence": [
            "source.pulse-store",
