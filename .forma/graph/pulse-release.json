    {
      "id": "pulse.acceptance",
      "role": "observation",
      "label": "Первый этап принят с ограничениями",
      "summary": {
        "text": "Документ pulse-next-steps фиксирует пользовательскую приёмку на 0.4.0-beta.2. Это историческое утверждение проекта о принятой бете с исключениями; обзор не выдаёт его за новый прогон или приёмку stable.",
        "provenance": {
          "recordedBy": "Codex",
          "recordedAt": "2026-10-20T23:24:58Z",
          "basis": "sourced",
          "evidence": [
